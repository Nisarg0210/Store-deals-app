rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Deals (existing) ──────────────────────────────────────────
    match /deals/{dealId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Rewards members ───────────────────────────────────────────
    // Guests are created without auth; staff (signed in) update balances.
    match /rewardsMembers/{memberId} {
      allow read: if true;
      allow create: if request.auth == null
        || (request.auth != null && request.auth.uid == memberId);
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Rewards transactions ──────────────────────────────────────
    // Only authenticated staff can earn, redeem, or revert.
    match /rewardsTransactions/{transactionId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
